@ Act 7: the Niobrara River after the ash (the same layout as StrataNiobrara).
StrataNiobraraAsh_MapScripts::
	.byte 0

StrataNiobrara_EventScript_NoteSilt::
	msgbox StrataNiobrara_Text_NoteSilt, MSGBOX_SIGN
	end

StrataNiobrara_Text_NoteSilt:
	.string "FIELD NOTE: Ash in the river\p"
	.string "Streams carried ash downstream and\n"
	.string "dropped it on bars and in\l"
	.string "backwaters. Ash laid down by water\l"
	.string "mixes with river sand and mud;\l"
	.string "ash that fell straight from the\l"
	.string "sky does not.\p"
	.string "Geologists use that to tell the\n"
	.string "two apart.$"
